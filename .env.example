# AWS Credentials & Region
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# AWS Resource Names
S3_EVIDENCE_BUCKET=smart-city-traffic-evidence-demo
S3_DATA_LAKE_BUCKET=smart-city-traffic-datalake-demo
DYNAMODB_TRAFFIC_TABLE=SmartCity_TrafficEvents
RDS_DB_NAME=smartcity_db
RDS_HOST=localhost
RDS_PORT=5432
RDS_USER=postgres
RDS_PASSWORD=postgres_password_here
SNS_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:AccidentAlertTopic

# Edge AI Pipeline Configurations
CAMERA_SOURCE=data/sample_traffic.mp4
DETECTION_CONFIDENCE_THRESHOLD=0.5
ACCIDENT_PROBABILITY_THRESHOLD=0.80
FRAME_BUFFER_SIZE=16
EMIT_TELEMETRY_INTERVAL_SEC=5
